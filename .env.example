# Signing secret for session + guest cookies. Use a long random value in production.
AUTH_SECRET=

# Public site URL: canonical links, sitemap and payment redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe billing (optional). Without these the checkout endpoint reports
# "stripe_not_configured" and card upgrades stay unavailable.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Crypto payments via Cryptomus (USDT BEP20 by default).
# Merchant UUID and Payment API key from the Cryptomus dashboard (Settings -> API).
# Put the real values in .env.local (gitignored) — never in this file.
# ---------------------------------------------------------------------------
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=3NCTbSDG8PFfQO4KjLjRJkQr2betwsMemamSfuaxNhDFLGMnmw8zPURO7Bgh6fpnlAy1ZbYmFz4Jfd78nRzYktvy46W4vIVdSr0V2wCUZcpVyh0vlf8Geo9RLF2i1JnY

# What the customer pays with.
CRYPTO_CURRENCY=USDT
CRYPTO_NETWORK=bsc
CRYPTO_NETWORK_LABEL=BEP20

# Pricing. Both offers can be enabled at once; leave a price empty to hide it.
# CRYPTO_PERIOD_DAYS=0 disables the prepaid period offer entirely.
CRYPTO_PERIOD_DAYS=30
CRYPTO_PERIOD_PRICE_USD=5
CRYPTO_LIFETIME_PRICE_USD=

# Optional: override the Cryptomus API base URL (used for local testing against a mock).
# CRYPTOMUS_API_URL=https://api.cryptomus.com
